{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "splitflow-household-pwa",
  "name": "SplitFlow — Household Ledger & Splitwise",
  "short_name": "SplitFlow",
  "description": "Household living expense tracking, Splitwise debt settlement, and automated Superstore receipt splitting",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#020617",
  "theme_color": "#4f46e5",
  "orientation": "portrait-primary",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["finance", "productivity", "utilities", "lifestyle"],
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/static/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Household Ledger",
      "short_name": "Ledger",
      "description": "View Splitwise balances and living expenses",
      "url": "/?source=pwa_shortcut",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Household Analytics",
      "short_name": "Analytics",
      "description": "View living cost trends and roommate ratios",
      "url": "/analytics/?source=pwa_shortcut",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Superstore Inbox",
      "short_name": "Inbox",
      "description": "Upload and assign Superstore grocery receipts",
      "url": "/receipts/?source=pwa_shortcut",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
